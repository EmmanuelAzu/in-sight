{"b":"Ps","c":87,"v":[{"n":1,"t":"His foundation is in the holy mountains.","it":[[15,17]],"x":[["Isa.56.7",10,"r"],["Isa.28.16",9,"w"],["Eph.2.20",7,"w"],["Eph.2.22",7,"r"],["1Cor.3.10",6,"w"],["1Cor.3.11",6,"w"],["Matt.16.18",6,"r"],["Isa.2.2",6,"w"],["Isa.2.3",6,"r"],["Zech.8.3",5,"r"]]},{"n":2,"t":"The LORD loveth the gates of Zion more than all the dwellings of Jacob.","x":[["Ps.132.13",6,"w"],["Ps.132.14",6,"r"],["Ps.78.67",5,"r"],["Ps.78.69",5,"r"],["Deut.12.5",4,"r"],["Joel.2.32",3,"w"],["Isa.14.32",2,"w"],["2Chr.6.6",2,"r"]]},{"n":3,"t":"Glorious things are spoken of thee, O city of God. Selah.","x":[["Ezek.36.11",6,"r"],["Ezek.36.38",6,"r"],["Ezek.37.27",6,"r"],["Ezek.37.28",6,"r"],["Rev.21.10",4,"r"],["Rev.21.27",4,"r"],["Ps.48.2",4,"r"],["Ps.48.3",4,"r"],["Rev.14.1",3,"r"],["Jer.31.12",3,"r"]]},{"n":4,"t":"I will make mention of Rahab and Babylon to them that know me: behold Philistia, and Tyre, with Ethiopia; this man was born there.","it":[[111,114]],"x":[["Ps.45.12",5,"w"],["Isa.19.23",4,"r"],["Isa.19.25",4,"r"],["Ps.68.31",4,"w"],["Job.9.13",3,"r"],["Ps.89.10",3,"w"],["Isa.23.1",2,"w"],["Isa.23.18",2,"r"],["Isa.13.1",2,"w"],["Isa.13.22",2,"r"]]},{"n":5,"t":"And of Zion it shall be said, This and that man was born in her: and the highest himself shall establish her.","it":[[39,47]],"x":[["Gal.3.26",5,"r"],["Gal.3.28",5,"r"],["Rom.8.31",4,"r"],["1Pet.1.23",4,"w"],["1Pet.1.24",4,"r"],["Ezek.48.35",4,"r"],["Heb.11.32",4,"r"],["Heb.12.2",4,"r"],["John.1.12",4,"r"],["John.1.14",4,"r"]]},{"n":6,"t":"The LORD shall count, when he writeth up the people, that this man was born there. Selah.","x":[["Isa.4.3",8,"r"],["Luke.10.20",6,"r"],["Ezek.13.9",5,"r"],["Rev.20.15",5,"r"],["Phil.4.3",4,"r"],["Ps.69.28",4,"r"],["Jer.3.19",3,"r"],["Ps.22.30",3,"r"],["Rev.13.8",3,"r"],["Ezek.9.4",2,"r"]]},{"n":7,"t":"As well the singers as the players on instruments shall be there: all my springs are in thee.","it":[[50,65],[81,84]],"x":[["Ps.36.9",10,"r"],["John.1.16",9,"r"],["Isa.12.3",8,"r"],["Rev.21.6",7,"r"],["Rev.22.17",7,"r"],["John.4.14",7,"w"],["Rev.22.1",6,"r"],["2Sam.6.14",6,"r"],["1Chr.23.5",6,"w"],["John.7.37",6,"r"]]}],"title":"A Psalm or Song for the sons of Korah."}