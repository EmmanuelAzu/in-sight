{"b":"Prov","c":1,"v":[{"n":1,"t":"The proverbs of Solomon the son of David, king of Israel;","x":[["Prov.10.1",28,"e"],["1Chr.22.9",4,"w"],["1Chr.28.5",3,"e"],["Eccl.1.1",3,"e"],["Prov.25.1",3,"e"],["1Kgs.2.12",3,"w"],["1Kgs.4.31",3,"r"],["1Kgs.4.32",3,"w"],["Eccl.12.9",2,"w"],["2Sam.12.24",2,"w"]]},{"n":2,"t":"To know wisdom and instruction; to perceive the words of understanding;","x":[["Prov.7.4",5,"w"],["Deut.4.5",4,"r"],["Deut.4.6",4,"w"],["Prov.8.5",2,"w"],["2Tim.3.15",2,"r"],["2Tim.3.17",2,"r"],["Prov.17.16",2,"w"],["1Kgs.3.9",2,"w"],["1Kgs.3.12",2,"w"],["Prov.4.5",1,"w"]]},{"n":3,"t":"To receive the instruction of wisdom, justice, and judgment, and equity;","x":[["Prov.2.1",14,"w"],["Prov.2.9",14,"w"],["Job.22.22",8,"w"],["1Kgs.3.28",4,"w"],["Prov.8.10",4,"w"],["Prov.8.11",4,"w"]]},{"n":4,"t":"To give subtilty to the simple, to the young man knowledge and discretion.","x":[["Prov.8.5",7,"w"],["Ps.119.9",4,"w"],["Prov.8.17",4,"r"],["Ps.119.130",3,"w"],["Prov.9.4",3,"w"],["Prov.9.6",3,"r"],["Prov.8.12",3,"w"],["Prov.8.32",3,"r"],["Prov.2.10",2,"w"],["Prov.2.11",2,"w"]]},{"n":5,"t":"A wise man will hear, and will increase learning; and a man of understanding shall attain unto wise counsels:","it":[[7,10]],"x":[["Prov.12.1",30,"r"],["Prov.9.9",18,"e"],["1Cor.10.15",9,"w"],["Job.34.16",8,"w"],["Job.34.10",7,"w"],["Ps.119.98",6,"r"],["Ps.119.100",6,"r"],["Job.34.34",4,"w"],["2Chr.25.16",3,"r"],["1Sam.25.32",2,"r"]]},{"n":6,"t":"To understand a proverb, and the interpretation; the words of the wise, and their dark sayings.","x":[["Ps.78.2",10,"w"],["Mark.4.11",8,"r"],["Heb.5.14",6,"r"],["Ps.49.4",6,"w"],["Mark.4.34",5,"r"],["Acts.8.30",5,"r"],["Acts.8.31",5,"r"],["Eccl.12.11",4,"w"],["Matt.13.10",4,"r"],["Matt.13.17",4,"r"]]},{"n":7,"t":"The fear of the LORD is the beginning of knowledge: but fools despise wisdom and instruction.","it":[[21,23],[52,55]],"x":[["Job.28.28",84,"e"],["Ps.111.10",57,"e"],["Ps.112.1",57,"r"],["Eccl.12.13",51,"w"],["Prov.9.10",51,"e"],["Prov.15.33",36,"e"],["Prov.18.2",29,"r"],["Prov.1.22",25,"w"],["Rom.1.28",24,"w"],["Prov.1.29",23,"w"]]},{"n":8,"t":"My son, hear the instruction of thy father, and forsake not the law of thy mother:","x":[["Prov.6.20",12,"q"],["Prov.30.17",7,"w"],["Prov.5.1",6,"r"],["Prov.5.2",6,"r"],["Prov.2.1",5,"r"],["Lev.19.3",4,"w"],["Prov.1.10",4,"r"],["Prov.31.1",4,"w"],["Prov.4.1",4,"e"],["Prov.4.4",4,"r"]]},{"n":9,"t":"For they shall be an ornament of grace unto thy head, and chains about thy neck.","it":[[9,17]],"x":[["Dan.5.29",8,"w"],["Prov.4.9",8,"w"],["Gen.41.42",6,"w"],["Prov.3.22",6,"w"],["Prov.6.20",4,"r"],["Prov.6.21",4,"w"],["Ezek.16.11",3,"w"],["Isa.3.19",3,"w"],["Song.1.10",2,"w"],["Dan.5.16",1,"w"]]},{"n":10,"t":"My son, if sinners entice thee, consent thou not.","x":[["Eph.5.11",20,"r"],["Prov.16.29",13,"r"],["Ps.1.1",11,"w"],["Prov.13.20",9,"r"],["Rom.16.18",7,"r"],["Deut.13.8",7,"w"],["Prov.7.21",5,"r"],["Prov.7.23",5,"r"],["Ps.50.18",3,"r"],["Prov.20.19",2,"r"]]},{"n":11,"t":"If they say, Come with us, let us lay wait for blood, let us lurk privily for the innocent without cause:","x":[["Prov.1.18",5,"q"],["Jer.5.26",5,"w"],["Prov.12.6",4,"w"],["Jer.18.18",3,"r"],["Jer.18.20",3,"r"],["Prov.1.16",2,"w"],["Ps.64.5",2,"w"],["Ps.64.6",2,"r"],["Ps.35.7",2,"w"],["Ps.10.8",2,"w"]]},{"n":12,"t":"Let us swallow them up alive as the grave; and whole, as those that go down into the pit:","x":[["Ps.124.3",5,"r"],["Ps.28.1",5,"w"],["Lam.2.16",3,"r"],["Rom.3.13",3,"r"],["Num.16.30",2,"e"],["Num.16.33",2,"w"],["Num.26.10",2,"r"],["Jer.51.34",2,"r"],["Ps.56.1",2,"w"],["Ps.56.2",2,"w"]]},{"n":13,"t":"We shall find all precious substance, we shall fill our houses with spoil:","x":[["1Tim.6.9",4,"r"],["1Tim.6.10",4,"r"],["Luke.12.15",3,"r"],["Job.24.2",3,"r"],["Job.24.3",3,"r"],["Rev.18.9",2,"r"],["Rev.18.16",2,"w"],["Prov.1.19",2,"r"],["Isa.10.13",2,"r"],["Isa.10.14",2,"r"]]},{"n":14,"t":"Cast in thy lot among us; let us all have one purse:"},{"n":15,"t":"My son, walk not thou in the way with them; refrain thy foot from their path:","x":[["Ps.119.101",13,"r"],["Ps.1.1",9,"r"],["Prov.4.27",8,"w"],["2Cor.6.17",6,"r"],["Prov.4.14",6,"w"],["Prov.4.15",6,"r"],["Ps.26.4",5,"r"],["Ps.26.5",5,"r"],["Prov.13.20",4,"r"],["Prov.5.8",3,"r"]]},{"n":16,"t":"For their feet run to evil, and make haste to shed blood.","x":[["Isa.59.7",7,"q"],["Prov.6.18",6,"w"],["Prov.4.16",4,"r"],["Rom.3.5",3,"r"]]},{"n":17,"t":"Surely in vain the net is spread in the sight of any bird.","x":[["Prov.7.23",4,"w"],["Jer.8.7",3,"r"],["Job.35.11",3,"r"],["Isa.1.3",2,"r"]]},{"n":18,"t":"And they lay wait for their own blood; they lurk privily for their own lives.","it":[[28,31],[67,70]],"x":[["Ps.9.16",6,"r"],["Esth.7.10",6,"r"],["Matt.27.4",4,"w"],["Matt.27.5",4,"r"],["Prov.5.22",4,"r"],["Prov.5.23",4,"r"],["Prov.28.17",4,"w"],["Ps.55.23",4,"r"],["Ps.7.14",3,"r"],["Ps.7.16",3,"r"]]},{"n":19,"t":"So are the ways of every one that is greedy of gain; which taketh away the life of the owners thereof.","it":[[3,6],[53,58]],"x":[["Prov.15.27",8,"w"],["2Pet.2.3",6,"r"],["Hab.2.9",4,"r"],["Prov.23.3",3,"r"],["Prov.23.4",3,"r"],["Mic.3.10",3,"r"],["Mic.3.12",3,"r"],["Mic.2.1",3,"r"],["Mic.2.3",3,"r"],["2Kgs.5.20",3,"r"]]},{"n":20,"t":"Wisdom crieth without; she uttereth her voice in the streets:","x":[["Prov.9.3",8,"w"],["Col.2.3",7,"w"],["Luke.11.49",6,"w"],["1Cor.1.24",6,"w"],["Prov.8.1",6,"w"],["Prov.8.5",6,"w"],["Matt.13.54",5,"w"],["1Cor.1.30",5,"w"],["John.7.37",4,"r"]]},{"n":21,"t":"She crieth in the chief place of concourse, in the openings of the gates: in the city she uttereth her words, saying,","it":[[110,117]],"x":[["Acts.5.20",5,"r"],["Matt.10.27",4,"r"],["Prov.9.3",4,"w"],["Matt.13.2",4,"r"],["John.18.20",3,"r"]]},{"n":22,"t":"How long, ye simple ones, will ye love simplicity? and the scorners delight in their scorning, and fools hate knowledge?","x":[["Prov.1.29",6,"w"],["Prov.5.12",6,"r"],["Ps.1.1",5,"r"],["John.3.20",4,"r"],["Matt.11.29",4,"r"],["Matt.11.30",4,"r"],["2Pet.3.3",4,"r"],["Luke.19.42",4,"r"],["Matt.9.13",4,"r"],["Rev.22.17",4,"r"]]},{"n":23,"t":"Turn you at my reproof: behold, I will pour out my spirit unto you, I will make known my words unto you.","x":[["Ezek.33.11",14,"w"],["Acts.3.19",12,"r"],["Ezek.18.27",10,"r"],["Ezek.18.30",10,"w"],["Joel.2.28",9,"w"],["Acts.2.36",8,"r"],["Acts.2.38",8,"r"],["Isa.32.15",7,"r"],["Isa.55.6",6,"r"],["Isa.55.7",6,"r"]]},{"n":24,"t":"Because I have called, and ye refused; I have stretched out my hand, and no man regarded;","x":[["Isa.65.12",9,"r"],["Rom.10.21",9,"w"],["Jer.7.13",8,"r"],["Isa.66.4",7,"r"],["Heb.12.25",6,"w"],["Heb.12.26",6,"r"],["Ezek.8.18",4,"r"],["Matt.22.5",4,"r"],["Matt.22.6",4,"r"],["Zech.7.11",3,"w"]]},{"n":25,"t":"But ye have set at nought all my counsel, and would none of my reproof:","x":[["Ps.81.11",6,"w"],["Luke.7.30",6,"w"],["Prov.1.30",5,"e"],["Prov.12.1",5,"w"],["2Chr.36.16",4,"r"],["Prov.5.12",4,"w"],["Ps.107.11",4,"w"]]},{"n":26,"t":"I also will laugh at your calamity; I will mock when your fear cometh;","x":[["Ps.37.13",7,"w"],["Ps.2.4",7,"w"],["Prov.10.24",6,"w"],["Luke.14.24",5,"r"],["Judg.10.14",4,"r"],["Prov.6.15",4,"w"]]},{"n":27,"t":"When your fear cometh as desolation, and your destruction cometh as a whirlwind; when distress and anguish cometh upon you.","x":[["Nah.1.3",3,"w"],["Prov.3.25",3,"e"],["Prov.3.26",3,"r"],["Rom.2.9",3,"w"],["Rev.6.15",2,"r"],["Rev.6.17",2,"r"],["Prov.10.24",2,"w"],["Prov.10.25",2,"w"],["Isa.17.13",2,"w"],["Ps.69.22",2,"r"]]},{"n":28,"t":"Then shall they call upon me, but I will not answer; they shall seek me early, but they shall not find me:","x":[["Mic.3.4",9,"r"],["Jas.4.3",8,"r"],["Job.27.9",6,"r"],["Isa.1.15",6,"r"],["Zech.7.13",6,"r"],["Jer.11.11",6,"r"],["Ps.18.41",5,"r"],["Matt.25.10",5,"r"],["Matt.25.12",5,"r"],["Jer.14.12",5,"r"]]},{"n":29,"t":"For that they hated knowledge, and did not choose the fear of the LORD:","x":[["Prov.1.22",6,"w"],["Job.21.14",6,"w"],["Job.21.15",6,"r"],["Prov.6.23",5,"r"],["Heb.11.25",4,"r"],["Isa.27.11",4,"r"],["Isa.30.9",3,"r"],["Isa.30.12",3,"r"],["Ps.50.16",3,"r"],["Ps.50.17",3,"r"]]},{"n":30,"t":"They would none of my counsel: they despised all my reproof.","x":[["Ps.81.11",7,"w"],["Prov.1.25",7,"e"],["Luke.14.18",3,"r"],["Luke.14.20",3,"r"],["Jer.8.9",2,"r"],["Ps.119.173",2,"r"],["Ps.119.111",1,"r"]]},{"n":31,"t":"Therefore shall they eat of the fruit of their own way, and be filled with their own devices.","x":[["Prov.14.14",11,"w"],["Prov.22.8",10,"r"],["Job.4.8",10,"r"],["Jer.6.19",10,"w"],["Gal.6.7",8,"r"],["Gal.6.8",8,"r"],["Isa.3.10",7,"w"],["Isa.3.11",7,"r"],["Jer.2.19",5,"r"]]},{"n":32,"t":"For the turning away of the simple shall slay them, and the prosperity of fools shall destroy them.","x":[["Prov.8.36",4,"r"],["Heb.12.25",4,"r"],["John.3.36",3,"r"],["Jer.2.19",3,"r"],["Luke.16.19",3,"r"],["Luke.16.25",3,"r"],["Luke.12.16",2,"r"],["Luke.12.21",2,"r"],["Jer.48.11",2,"r"],["Jer.48.12",2,"r"]]},{"n":33,"t":"But whoso hearkeneth unto me shall dwell safely, and shall be quiet from fear of evil.","x":[["Ps.25.12",29,"r"],["Ps.25.13",29,"w"],["Ps.112.7",19,"r"],["Ps.112.8",19,"r"],["Isa.26.3",15,"r"],["Luke.21.9",11,"r"],["John.10.27",11,"r"],["John.10.29",11,"r"],["Prov.14.26",10,"w"],["Prov.8.32",9,"r"]]}]}