{"b":"Ps","c":103,"v":[{"n":1,"t":"Bless the LORD, O my soul: and all that is within me, bless his holy name.","it":[[54,59]],"x":[["Ps.146.1",28,"r"],["Ps.146.2",28,"r"],["John.4.24",25,"r"],["Ps.57.7",25,"r"],["Ps.57.11",25,"r"],["1Cor.14.15",22,"r"],["Ps.111.1",22,"r"],["Ps.103.22",19,"e"],["Ps.104.1",19,"e"],["Ps.99.3",18,"r"]]},{"n":2,"t":"Bless the LORD, O my soul, and forget not all his benefits:","x":[["Isa.63.7",26,"r"],["Ps.116.12",25,"w"],["Ps.105.5",17,"r"],["Luke.17.15",14,"r"],["Luke.17.18",14,"r"],["Deut.6.12",12,"w"],["Deut.32.18",8,"r"],["Deut.32.6",7,"r"],["2Chr.32.25",7,"r"],["Deut.8.10",6,"w"]]},{"n":3,"t":"Who forgiveth all thine iniquities; who healeth all thy diseases;","x":[["Exod.15.26",69,"w"],["Isa.53.5",59,"w"],["Ps.30.2",43,"r"],["Jer.17.14",41,"r"],["Ps.41.3",35,"r"],["Ps.41.4",35,"r"],["Ps.147.3",32,"w"],["Mark.2.10",28,"r"],["Mark.2.11",28,"r"],["Jas.5.15",25,"r"]]},{"n":4,"t":"Who redeemeth thy life from destruction; who crowneth thee with lovingkindness and tender mercies;","x":[["Ps.71.23",17,"r"],["Ps.56.13",16,"r"],["Ps.103.12",15,"r"],["Ps.8.5",12,"r"],["1Pet.5.4",12,"r"],["Ps.5.12",11,"r"],["Jas.1.12",10,"r"],["Ps.34.22",10,"w"],["Rev.5.9",9,"r"],["Ps.21.3",7,"r"]]},{"n":5,"t":"Who satisfieth thy mouth with good things; so that thy youth is renewed like the eagle’s.","it":[[35,50]],"x":[["Isa.40.31",53,"r"],["Ps.107.9",43,"w"],["2Cor.4.16",24,"w"],["1Tim.6.17",24,"r"],["Ps.63.5",22,"w"],["Ps.104.28",20,"r"],["Ps.23.5",16,"r"],["Ps.65.4",13,"r"],["Hos.2.15",8,"w"],["Ps.115.15",4,"r"]]},{"n":6,"t":"The LORD executeth righteousness and judgment for all that are oppressed.","x":[["Ps.12.5",14,"r"],["Ps.9.9",13,"w"],["Ps.72.12",9,"r"],["Ps.146.7",8,"e"],["Prov.14.31",7,"r"],["Ps.109.31",6,"r"],["Jas.2.6",6,"w"],["Prov.22.22",5,"r"],["Prov.22.23",5,"r"],["Deut.24.14",5,"r"]]},{"n":7,"t":"He made known his ways unto Moses, his acts unto the children of Israel.","x":[["Exod.33.13",16,"r"],["Ps.147.19",11,"r"],["Ps.78.11",8,"r"],["Neh.9