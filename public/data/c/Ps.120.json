{"b":"Ps","c":120,"v":[{"n":1,"t":"In my distress I cried unto the LORD, and he heard me.","x":[["Ps.18.6",20,"e"],["Jonah.2.2",17,"e"],["Ps.118.5",13,"w"],["Heb.5.7",11,"r"],["Ps.50.15",11,"r"],["Ps.130.1",9,"w"],["Ps.107.13",8,"w"],["Isa.37.3",8,"r"],["Isa.37.4",8,"r"],["Luke.22.44",8,"r"]]},{"n":2,"t":"Deliver my soul, O LORD, from lying lips, and from a deceitful tongue.","it":[[42,45]],"tags":["prayer"],"tm":{"prayer":"Addresses God directly: “O LORD”."},"x":[["Prov.12.22",3,"w"],["Ps.109.1",3,"r"],["Ps.109.2",3,"w"],["Matt.26.59",2,"r"],["Matt.26.62",2,"r"],["Ps.35.11",2,"r"],["Ps.140.1",2,"w"],["Ps.140.3",2,"w"],["Ps.52.2",2,"w"],["Ps.52.4",2,"w"]]},{"n":3,"t":"What shall be given unto thee? or what shall be done unto thee, thou false tongue?","x":[["Job.27.8",2,"r"],["Matt.16.26",2,"r"],["Rom.6.21",2,"r"]]},{"n":4,"t":"Sharp arrows of the mighty, with coals of juniper.","x":[["Prov.19.9",4,"r"],["Prov.18.21",4,"r"],["Prov.19.5",3,"r"],["Ps.45.5",3,"w"],["Prov.16.27",3,"r"],["Jas.3.5",3,"r"],["Jas.3.8",3,"r"],["Deut.32.23",2,"w"],["Deut.32.24",2,"r"],["Ps.140.9",2,"r"]]},{"n":5,"t":"Woe is me, that I sojourn in Mesech, that I dwell in the tents of Kedar!","it":[[37,41]],"x":[["Gen.10.2",6,"r"],["Ezek.27.13",4,"r"],["Gen.25.13",4,"w"],["Song.1.5",3,"w"],["Isa.60.6",2,"r"],["Isa.60.7",2,"w"],["Ezek.39.1",2,"r"],["Jer.9.2",2,"r"],["Jer.9.3",2,"r"],["Ezek.27.21",2,"w"]]},{"n":6,"t":"My soul hath long dwelt with him that hateth peace.","x":[["Matt.10.16",6,"r"],["Ezek.2.6",5,"r"],["Ps.57.4",5,"r"],["Matt.10.36",4,"r"],["1Sam.20.30",2,"r"],["1Sam.20.33",2,"r"],["Titus.3.3",1,"r"]]},{"n":7,"t":"I am for peace: but when I speak, they are for war.","it":[[2,8],[39,42]],"x":[["Matt.5.9",22,"r"],["Ps.109.4",7,"r"],["Heb.12.14",4,"w"],["Rom.12.18",3,"r"],["Ps.34.14",3,"w"],["1Sam.24.9",2,"r"],["1Sam.24.11",2,"r"],["1Sam.26.2",2,"r"],["1Sam.26.4",2,"r"],["Ps.55.20",2,"w"]]}],"title":"A Song of degrees."}