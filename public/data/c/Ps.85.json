{"b":"Ps","c":85,"v":[{"n":1,"t":"LORD, thou hast been favourable unto thy land: thou hast brought back the captivity of Jacob.","x":[["Ps.14.7",11,"e"],["Jer.30.18",10,"e"],["Ps.77.7",7,"w"],["Ezek.39.25",7,"e"],["Joel.2.18",6,"r"],["Ps.126.1",6,"w"],["Ps.126.2",6,"r"],["Ps.42.1",6,"r"],["Joel.3.1",5,"w"],["Lev.26.42",5,"w"]]},{"n":2,"t":"Thou hast forgiven the iniquity of thy people, thou hast covered all their sin. Selah.","x":[["Mic.7.18",9,"w"],["Col.2.13",8,"w"],["Ps.32.1",8,"w"],["Num.14.19",6,"w"],["Acts.13.39",5,"r"],["Jer.50.20",5,"w"],["Ps.79.8",5,"r"],["Ps.79.9",5,"r"],["Ps.78.38",4,"w"]]},{"n":3,"t":"Thou hast taken away all thy wrath: thou hast turned thyself from the fierceness of thine anger.","it":[[53,60]],"x":[["Ps.106.23",6,"w"],["Deut.13.17",6,"w"],["Jonah.3.9",4,"w"],["Isa.12.1",4,"w"],["Isa.6.7",3,"w"],["Ps.78.38",3,"e"],["Exod.32.22",2,"w"],["Isa.54.7",2,"r"],["Isa.54.10",2,"r"],["John.1.29",2,"r"]]},{"n":4,"t":"Turn us, O God of our salvation, and cause thine anger toward us to cease.","tags":["prayer"],"tm":{"prayer":"Addresses God directly: “O God”."},"x":[["Ps.80.3",7,"e"],["Ps.80.7",5,"e"],["Lam.5.21",4,"w"],["Mic.7.7",4,"w"],["Ps.80.19",3,"e"],["Mal.4.6",3,"w"],["Mic.7.18",3,"w"],["Mic.7.20",3,"r"],["Ps.27.1",3,"w"],["Ps.25.2",3,"r"]]},{"n":5,"t":"Wilt thou be angry with us for ever? wilt thou draw out thine anger to all generations?","x":[["Ps.79.5",5,"w"],["Ps.80.4",4,"w"],["Ps.74.1",3,"w"],["Rev.18.21",2,"r"],["Rev.18.23",2,"r"],["Isa.64.9",2,"r"],["Isa.64.12",2,"r"],["Ps.89.46",2,"r"],["Ps.77.9",2,"w"],["Mic.7.18",2,"w"]]},{"n":6,"t":"Wilt thou not revive us again: that thy people may rejoice in thee?","x":[["Hab.3.2",18,"w"],["Ps.80.18",17,"r"],["Isa.57.15",15,"w"],["Ps.90.14",14,"w"],["Hos.6.2",12,"w"],["Ps.71.20",12,"r"],["Ps.53.6",10,"w"],["Ps.138.7",9,"w"],["Ezra.9.8",7,"r"],["Ezra.9.9",7,"r"]]},{"n":7,"t":"Shew us thy mercy, O LORD, and grant us thy salvation.","tags":["prayer"],"tm":{"prayer":"Addresses God directly: “O LORD”."},"x":[["Ps.91.16",5,"w"],["Ps.50.23",4,"w"],["Jer.42.12",3,"w"]]},{"n":8,"t":"I will hear what God the LORD will speak: for he will speak peace unto his people, and to his saints: but let them not turn again to folly.","x":[["Ps.29.11",11,"w"],["Rev.3.19",10,"r"],["Zech.9.10",9,"w"],["2Tim.2.19",8,"r"],["Hab.2.1",8,"r"],["Heb.10.26",8,"r"],["Heb.10.29",8,"r"],["John.14.27",7,"w"],["Gen.34.7",6,"w"],["Ps.130.4",6,"r"]]},{"n":9,"t":"Surely his salvation is nigh them that fear him; that glory may dwell in our land.","it":[[21,23]],"x":[["Isa.46.13",13,"w"],["Zech.2.5",13,"w"],["John.7.17",9,"r"],["Ps.24.4",8,"r"],["Ps.24.5",8,"w"],["Luke.2.32",8,"w"],["Zech.2.8",8,"w"],["Acts.11.13",7,"r"],["Acts.11.14",7,"r"],["Ezek.26.20",7,"w"]]},{"n":10,"t":"Mercy and truth are met together; righteousness and peace have kissed each other.","it":[[70,81]],"x":[["Prov.3.3",13,"w"],["Ps.89.14",11,"w"],["Isa.32.16",10,"w"],["Isa.32.18",10,"r"],["Ps.100.5",10,"w"],["John.1.17",10,"w"],["Rom.5.21",7,"w"],["Ps.72.3",7,"w"],["Isa.45.24",6,"w"],["Mic.7.20",6,"w"]]},{"n":11,"t":"Truth shall spring out of the earth; and righteousness shall look down from heaven.","x":[["John.14.6",10,"w"],["Isa.45.8",10,"e"],["1John.5.20",8,"r"],["1John.5.21",8,"r"],["Luke.2.14",4,"r"],["Matt.3.17",4,"r"],["Isa.4.2",4,"r"],["Eph.1.6",4,"r"],["Isa.53.2",4,"r"],["Isa.42.21",4,"w"]]},{"n":12,"t":"Yea, the LORD shall give that which is good; and our land shall yield her increase.","it":[[25,38]],"x":[["Jas.1.17",16,"r"],["Ps.84.11",15,"e"],["Ps.67.6",9,"w"],["Lev.26.4",7,"e"],["1Cor.1.30",6,"r"],["Isa.30.23",6,"w"],["Isa.30.24",6,"r"],["Eph.1.3",4,"r"],["Zech.8.12",3,"w"],["Mic.6.8",3,"r"]]},{"n":13,"t":"Righteousness shall go before him; and shall set us in the way of his steps.","it":[[49,51]],"x":[["Ps.89.14",6,"r"],["John.13.34",5,"r"],["1Pet.4.1",4,"r"],["1John.2.6",4,"r"],["Isa.58.8",4,"w"],["Gal.2.20",4,"r"],["2Cor.3.18",4,"r"],["1Pet.2.18",4,"r"],["1Pet.2.24",4,"w"],["Eph.5.1",3,"r"]]}],"title":"To the