{"b":"Ps","c":150,"v":[{"n":1,"t":"Praise ye the LORD. Praise God in his sanctuary: praise him in the firmament of his power.","x":[["Ps.149.1",11,"w"],["Ps.134.2",9,"w"],["Ps.116.18",6,"r"],["Ps.116.19",6,"w"],["Ps.29.9",5,"r"],["Ezek.10.1",4,"w"],["Dan.12.3",4,"w"],["Gen.1.6",3,"w"],["Gen.1.8",3,"w"],["Ps.102.19",3,"w"]]},{"n":2,"t":"Praise him for his mighty acts: praise him according to his excellent greatness.","x":[["Deut.3.24",10,"w"],["Jer.32.17",8,"r"],["Jer.32.19",8,"w"],["Ps.145.5",6,"r"],["Ps.145.6",6,"w"],["Ps.145.3",5,"w"],["Rev.15.3",4,"r"],["Rev.15.4",4,"r"],["Ps.96.4",4,"r"],["Ps.145.12",3,"w"]]},{"n":3,"t":"Praise him with the sound of the trumpet: praise him with the psaltery and harp.","x":[["Ps.33.2",7,"w"],["Ps.149.3",5,"w"],["Ps.81.2",4,"w"],["Ps.81.3",4,"w"],["Ps.98.5",4,"w"],["Ps.98.6",4,"w"],["Ps.92.3",3,"w"],["1Chr.15.28",2,"w"],["1Chr.16.42",2,"w"],["1Chr.15.24",2,"r"]]},{"n":4,"t":"Praise him with the timbrel and dance: praise him with stringed instruments and organs.","x":[["Ps.149.3",9,"w"],["Isa.38.20",8,"w"],["Exod.15.20",7,"w"],["Ps.92.3",3,"r"],["Ps.144.9",3,"r"],["Job.30.31",3,"r"],["Ps.45.8",2,"r"],["Job.21.12",2,"w"],["Ps.33.2",2,"w"],["Hab.3.19",1,"w"]]},{"n":5,"t":"Praise him upon the loud cymbals: praise him upon the high sounding cymbals.","x":[["1Chr.15.16",6,"w"],["1Chr.25.1",5,"w"],["1Chr.15.28",4,"w"],["1Chr.15.19",4,"w"],["1Chr.25.6",4,"w"],["2Sam.6.5",3,"w"],["1Chr.16.5",3,"w"],["1Chr.13.8",2,"w"]]},{"n":6,"t":"Let every thing that hath breath praise the LORD. Praise ye the LORD.","x":[["Ps.145.21",25,"w"],["Ps.103.22",23,"r"],["Rev.5.13",23,"r"],["Ps.148.7",16,"w"],["Ps.148.11",16,"r"],["Ps.145.10",14,"w"]]}]}