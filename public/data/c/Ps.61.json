{"b":"Ps","c":61,"v":[{"n":1,"t":"Hear my cry, O God; attend unto my prayer.","tags":["prayer"],"tm":{"prayer":"Addresses God directly: “O God”."},"x":[["Phil.4.6",24,"w"],["Ps.4.1",23,"e"],["Ps.86.6",7,"w"],["Ps.130.2",5,"r"],["Ps.55.1",4,"w"],["Ps.55.2",4,"w"],["Ps.5.1",3,"r"],["Ps.5.3",3,"w"],["Ps.17.1",3,"e"],["Ps.54.1",3,"r"]]},{"n":2,"t":"From the end of the earth will I cry unto thee, when my heart is overwhelmed: lead me to the rock that is higher than I.","it":[[98,102]],"x":[["Ps.18.2",32,"w"],["Ps.139.9",30,"r"],["Ps.139.10",30,"w"],["Isa.32.2",17,"w"],["Ps.62.6",15,"w"],["Ps.62.2",13,"w"],["Ps.18.46",13,"w"],["Ps.77.3",13,"w"],["Deut.4.29",13,"r"],["Ps.27.5",12,"w"]]},{"n":3,"t":"For thou hast been a shelter for me, and a strong tower from the enemy.","it":[[37,40]],"x":[["Prov.18.10",11,"w"],["Ps.62.7",8,"r"],["Ps.140.7",7,"r"],["2Cor.1.10",6,"r"],["Ps.116.2",6,"r"],["Ps.18.2",6,"w"],["Isa.46.3",4,"r"],["Isa.46.4",4,"r"],["Ps.4.6",4,"r"],["Ps.4.7",4,"r"]]},{"n":4,"t":"I will abide in thy tabernacle for ever: I will trust in the covert of thy wings. Selah.","x":[["Ps.27.4",10,"r"],["Ps.23.6",10,"r"],["Ps.17.8",9,"w"],["Ps.91.4",8,"w"],["Ps.63.7",7,"w"],["Ps.15.1",7,"w"],["Ps.57.1",7,"w"],["Ruth.2.12",6,"w"],["Matt.23.37",6,"w"],["Ps.62.7",6,"r"]]},{"n":5,"t":"For thou, O God, hast heard my vows: thou hast given me the heritage of those that fear thy name.","it":[[53,55]],"tags":["prayer"],"tm":{"prayer":"Addresses God directly: “O God”."},"x":[["Ps.56.12",6,"w"],["Ps.115.13",5,"w"],["Mal.3.16",5,"r"],["Mal.3.18",5,"r"],["Ps.86.11",5,"w"],["Ps.65.1",4,"r"],["Ps.16.5",4,"r"],["Ps.16.6",4,"w"],["Acts.10.35",4,"r"],["Ps.66.19",4,"r"]]},{"n":6,"t":"Thou wilt prolong the king’s life: and his years as many generations.","it":[[35,38]],"x":[["Ps.21.4",6,"r"],["Ps.89.36",5,"r"],["Ps.89.37",5,"r"],["Ps.21.6",4,"r"],["Isa.53.10",3,"w"],["Ps.72.15",3,"r"],["Ps.72.17",3,"r"]]},{"n":7,"t":"He shall abide before God for ever: O prepare mercy and truth, which may preserve him.","it":[[63,68]],"x":[["Ps.40.11",8,"w"],["Gen.24.27",6,"w"],["Ps.41.12",5,"r"],["Ps.57.3",5,"w"],["Prov.20.28",4,"e"],["Luke.1.33",4,"r"],["Heb.9.24",4,"r"],["Ps.43.3",4,"w"],["Isa.9.6",4,"r"],["Isa.9.7",4,"r"]]},{"n":8,"t":"So will I sing praise unto thy name for ever, that I may daily perform my vows.","x":[["Ps.65.1",5,"w"],["Ps.145.1",4,"r"],["Ps.145.2",4,"e"],["Ps.79.13",3,"w"],["Ps.71.22",3,"w"],["Ps.66.13",3,"w"],["Ps.66.16",3,"r"],["Ps.30.12",1,"e"],["Ps.146.2",1,"w"]]}],"title":"To the chief Musician upon Neginah, A Psalm of David."}