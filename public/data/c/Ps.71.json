{"b":"Ps","c":71,"v":[{"n":1,"t":"In thee, O LORD, do I put my trust: let me never be put to confusion.","tags":["prayer"],"tm":{"prayer":"Addresses God directly: “O LORD”."},"x":[["Ps.31.1",15,"e"],["Ps.31.3",15,"r"],["Ps.25.2",10,"w"],["Ps.25.3",10,"r"],["1Pet.2.6",9,"r"],["Ps.22.5",6,"r"],["Ps.125.1",5,"w"],["Jer.17.18",5,"r"],["1Chr.5.20",4,"w"],["Isa.45.17",4,"r"]]},{"n":2,"t":"Deliver me in thy righteousness, and cause me to escape: incline thine ear unto me, and save me.","x":[["Ps.31.1",9,"w"],["Ps.17.6",7,"w"],["Ps.116.1",6,"r"],["Ps.116.2",6,"w"],["Ps.143.11",6,"w"],["Ps.34.15",5,"r"],["Ps.143.1",5,"w"],["Dan.9.16",5,"w"],["Ps.43.1",5,"w"],["Ps.10.17",5,"w"]]},{"n":3,"t":"Be thou my strong habitation, whereunto I may continually resort: thou hast given commandment to save me; for thou art my rock and my fortress.","it":[[115,118]],"x":[["Ps.18.2",10,"w"],["Prov.18.10",7,"w"],["Ps.31.2",7,"w"],["Ps.31.3",7,"w"],["Ps.91.9",7,"w"],["Deut.33.27",6,"r"],["Ps.44.4",5,"r"],["Ps.91.11",5,"r"],["Ps.91.12",5,"r"],["Ps.42.8",5,"r"]]},{"n":4,"t":"Deliver me, O my God, out of the hand of the wicked, out of the hand of the unrighteous and cruel man.","tags":["prayer"],"tm":{"prayer":"Addresses God directly: “O my God”."},"x":[["Ps.140.1",4,"w"],["Ps.140.4",4,"w"],["Ps.59.1",4,"w"],["Ps.59.2",4,"w"],["Ps.17.13",3,"w"],["2Sam.17.1",3,"r"],["2Sam.17.2",3,"r"],["Ps.17.8",3,"r"],["Ps.17.9",3,"w"],["2Sam.17.21",2,"r"]]},{"n":5,"t":"For thou art my hope, O Lord GOD: thou art my trust from my youth.","it":[[9,12],[34,42]],"tags":["prayer"],"tm":{"prayer":"Addresses God directly: “O Lord”."},"x":[["Jer.17.7",10,"w"],["Ps.39.7",9,"w"],["Ps.71.17",8,"w"],["Ps.119.81",7,"w"],["Jer.17.17",6,"w"],["Ps.119.166",5,"r"],["1Sam.17.45",5,"r"],["1Sam.17.47",5,"r"],["Ps.22.9",5,"w"],["Ps.22.10",5,"r"]]},{"n":6,"t":"By thee have I been holden up from the womb: thou art he that took me out of my mother’s bowels: my praise shall be continually of thee.","it":[[107,115]],"x":[["Ps.22.9",17,"w"]