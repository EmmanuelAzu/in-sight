{"b":"Job","c":17,"v":[{"n":1,"t":"My breath is corrupt, my days are extinct, the graves are ready for me.","it":[[54,63]],"x":[["Isa.38.10",5,"r"],["Isa.38.14",5,"r"],["Ps.88.3",4,"r"],["Ps.88.5",4,"r"],["Job.6.11",3,"r"],["Job.17.13",3,"r"],["Job.17.14",3,"r"],["Job.19.17",3,"w"],["Isa.57.16",3,"r"],["Job.42.16",3,"r"]]},{"n":2,"t":"Are there not mockers with me? and doth not mine eye continue in their provocation?","it":[[0,9]],"x":[["1Sam.1.6",4,"r"],["1Sam.1.7",4,"r"],["Job.12.4",3,"r"],["Job.16.20",3,"w"],["Matt.27.39",3,"r"],["Matt.27.44",3,"r"],["Ps.25.13",2,"r"],["Job.13.9",2,"r"],["Ps.91.1",2,"r"],["Ps.35.14",2,"r"]]},{"n":3,"t":"Lay down now, put me in a surety with thee; who is he that will strike hands with me?","it":[[48,50],[54,58]],"x":[["Isa.38.14",4,"r"],["Heb.7.22",4,"w"],["Prov.11.15",4,"w"],["Gen.43.9",3,"w"],["Ps.119.122",3,"w"],["Gen.44.32",3,"w"],["Job.9.33",2,"w"],["Prov.6.11",1,"r"],["Prov.20.16",1,"w"],["Prov.17.18",1,"w"]]},{"n":4,"t":"For thou hast hid their heart from understanding: therefore shalt thou not exalt them.","it":[[81,86]],"x":[["Matt.11.25",6,"w"],["Matt.13.11",5,"r"],["1Cor.1.20",4,"r"],["2Sam.17.14",4,"r"],["Rom.11.8",3,"r"],["Isa.19.14",3,"r"],["2Chr.25.16",2,"r"],["2Sam.15.31",1,"r"]]},{"n":5,"t":"He that speaketh flattery to his friends, even the eyes of his children shall fail.","it":[[29,32]],"x":[["Prov.20.19",3,"r"],["Ps.12.2",3,"r"],["Ps.12.3",3,"w"],["Job.11.20",2,"w"],["1Kgs.11.12",2,"r"],["Deut.28.65",2,"r"],["Job.32.21",2,"r"],["Job.32.22",2,"r"],["Prov.29.5",2,"r"],["Exod.20.5",2,"r"]]},{"n":6,"t":"He hath made me also a byword of the people; and aforetime I was as a tabret.","x":[["Job.30.9",5,"w"],["Ps.44.14",5,"w"],["Gen.31.27",2,"w"],["1Kgs.9.7",2,"w"],["Isa.5.12",2,"w"]]},{"n":7,"t":"Mine eye also is dim by reason of sorrow, and all my members are as a shadow.","it":[[61,64]],"x":[["Job.16.16",4,"w"],["Ps.31.9",3,"w"],["Ps.31.10",3,"r"],["Ps.6.7",3,"w"],["Lam.5.17",2,"w"],["Ps.109.23",2,"w"],["Job.16.8",