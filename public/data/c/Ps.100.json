{"b":"Ps","c":100,"v":[{"n":1,"t":"Make a joyful noise unto the LORD, all ye lands.","x":[["Ps.98.4",38,"e"],["Luke.19.37",21,"r"],["Zeph.3.14",15,"r"],["Ps.32.11",15,"r"],["Rom.15.10",13,"r"],["Ps.95.1",12,"w"],["Ps.95.2",12,"w"],["Isa.42.10",11,"r"],["Isa.42.12",11,"r"],["Ps.117.1",9,"r"]]},{"n":2,"t":"Serve the LORD with gladness: come before his presence with singing.","x":[["Phil.4.4",35,"r"],["Ps.71.23",19,"r"],["Ps.95.2",18,"w"],["Acts.2.46",14,"w"],["Acts.2.47",14,"r"],["Deut.28.47",13,"w"],["2Chr.20.27",13,"r"],["2Chr.20.28",13,"r"],["Ps.42.4",11,"r"],["Ps.107.21",11,"r"]]},{"n":3,"t":"Know ye that the LORD he is God: it is he that hath made us, and not we ourselves; we are his people, and the sheep of his pasture.","it":[[25,27],[33,38],[42,46],[83,89]],"x":[["Ps.95.6",41,"r"],["Ps.95.7",41,"e"],["Ps.46.10",35,"r"],["Ps.119.73",33,"r"],["John.17.3",29,"r"],["Eph.2.10",28,"r"],["1John.5.20",19,"r"],["Ezek.34.30",17,"e"],["Ezek.34.31",17,"w"],["1Pet.4.19",16,"r"]]},{"n":4,"t":"Enter into his gates with thanksgiving, and into his courts with praise: be thankful unto him, and bless his name.","it":[[40,43],[95,98]],"x":[["Col.3.16",48,"r"],["Col.3.17",48,"r"],["Heb.13.15",38,"w"],["Ps.103.1",26,"w"],["Ps.103.2",26,"w"],["1Chr.29.13",25,"w"],["Ps.116.17",22,"w"],["Ps.116.19",22,"w"],["Ps.66.13",21,"r"],["Ps.145.1",20,"w"]]},{"n":5,"t":"For the LORD is good; his mercy is everlasting; and his truth endureth to all generations.","it":[[13,15],[32,34],[62,70]],"x":[["Ps.106.1",24,"e"],["Ps.107.1",23,"e"],["Ps.36.5",21,"w"],["Ps.86.5",21,"e"],["Jer.33.11",20,"e"],["1Chr.16.34",20,"e"],["Ps.136.1",19,"e"],["Ps.136.26",19,"w"],["Ps.103.17",16,"w"],["Luke.1.50",13,"w"]]}],"title":"A Psalm of praise."}