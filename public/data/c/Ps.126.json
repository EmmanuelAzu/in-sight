{"b":"Ps","c":126,"v":[{"n":1,"t":"When the LORD turned again the captivity of Zion, we were like them that dream.","x":[["Hos.6.11",23,"w"],["Joel.3.1",16,"w"],["Jer.31.8",13,"r"],["Jer.31.10",13,"r"],["Ps.85.1",13,"w"],["Acts.12.9",12,"r"],["Ps.120.1",12,"r"],["Ps.53.6",11,"w"],["Ps.123.1",11,"r"],["Job.42.10",10,"e"]]},{"n":2,"t":"Then was our mouth filled with laughter, and our tongue with singing: then said they among the heathen, The LORD hath done great things for them.","x":[["Job.8.21",10,"w"],["Isa.35.10",7,"r"],["Ps.71.19",6,"r"],["Zech.8.22",6,"r"],["Zech.8.23",6,"r"],["Jer.33.11",4,"r"],["Ps.106.47",4,"w"],["Ps.106.48",4,"r"],["Neh.6.16",4,"w"],["Ps.53.6",4,"r"]]},{"n":3,"t":"The LORD hath done great things for us; whereof we are glad.","it":[[40,47]],"x":[["Luke.1.49",14,"r"],["Isa.66.14",8,"r"],["Isa.12.4",7,"r"],["Isa.12.6",7,"r"],["Isa.51.9",7,"r"],["Isa.51.11",7,"r"],["Eph.1.18",4,"r"],["Eph.1.22",4,"r"],["Rev.19.1",4,"r"],["Rev.19.7",4,"w"]]},{"n":4,"t":"Turn again our captivity, O LORD, as the streams in the south.","tags":["prayer"],"tm":{"prayer":"Addresses God directly: “O LORD”."},"x":[["Ps.85.4",7,"w"],["Ps.126.1",5,"w"],["Josh.3.16",5,"r"],["Isa.43.19",5,"r"],["Isa.35.6",5,"w"],["Isa.41.18",5,"r"],["Hos.1.11",5,"r"]]},{"n":5,"t":"They that sow in tears shall reap in joy.","x":[["Gal.6.9",35,"w"],["Isa.35.10",31,"w"],["John.16.20",21,"w"],["John.16.22",21,"w"],["Joel.2.23",17,"r"],["Matt.5.4",16,"r"],["Isa.12.1",13,"r"],["Isa.12.3",13,"w"],["Jer.31.9",12,"r"],["Jer.31.13",12,"w"]]},{"n":6,"t":"He that goeth forth and weepeth, bearing precious seed, shall doubtless come again with rejoicing, bringing his sheaves with him.","it":[[120,129]],"x":[["Gal.6.7",12,"r"],["Gal.6.8",12,"r"],["Isa.9.2",12,"r"],["Isa.9.3",12,"r"],["Ps.30.5",10,"r"],["Isa.61.3",9,"r"],["Job.11.13",9,"r"],["Job.11.17",9,"r"],["Rev.7.15",8,"r"],["Rev.7.17",8,"r"]]}],"title":"A Song of degrees."}