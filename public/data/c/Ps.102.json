"r"],["2Kgs.13.22",6,"r"],["2Kgs.13.23",6,"r"],["Eph.2.2",6,"r"]]},{"n":21,"t":"To declare the name of the LORD in Zion, and his praise in Jerusalem;","x":[["Ps.22.22",5,"e"],["Eph.3.21",2,"r"],["1Pet.2.9",2,"r"],["Ps.79.13",2,"w"],["Isa.51.11",2,"w"],["Ps.9.13",2,"r"],["Ps.9.14",2,"w"],["Ps.51.14",2,"r"],["Ps.51.15",2,"w"],["Eph.2.4",1,"r"]]},{"n":22,"t":"When the people are gathered together, and the kingdoms, to serve the LORD.","x":[["Zech.8.20",4,"r"],["Zech.8.23",4,"r"],["Isa.49.22",3,"r"],["Isa.49.23",3,"r"],["Matt.24.14",3,"r"],["Ps.72.8",3,"r"],["Ps.72.11",3,"w"],["Isa.60.3",2,"r"],["Isa.60.22",2,"r"],["Gen.49.10",2,"r"]]},{"n":23,"t":"He weakened my strength in the way; he shortened my days.","x":[["Ps.89.38",2,"r"],["Ps.89.47",2,"r"],["2Thess.2.3",2,"r"],["2Thess.2.12",2,"r"],["1Tim.4.1",2,"r"],["1Tim.4.3",2,"r"],["2Tim.3.1",2,"r"],["2Tim.3.17",2,"r"],["Rev.11.2",2,"r"],["Rev.11.19",2,"r"]]},{"n":24,"t":"I said, O my God, take me not away in the midst of my days: thy years are throughout all generations.","it":[[70,73]],"tags":["prayer"],"tm":{"prayer":"Addresses God directly: “O my God”."},"x":[["Ps.39.13",5,"r"],["Hab.1.12",4,"r"],["Ps.102.12",4,"w"],["Isa.38.10",3,"r"],["Isa.38.22",3,"r"],["Rev.1.8",3,"r"],["Ps.9.7",2,"r"],["Ps.90.1",2,"w"],["Ps.90.2",2,"r"],["Rev.1.4",2,"r"]]},{"n":25,"t":"Of old hast thou laid the foundation of the earth: and the heavens are the work of thy hands.","it":[[67,70]],"tags":["nt"],"tm":{"nt":"Quotes Heb 1:10 (11 reader votes, OpenBible.info)."},"x":[["Gen.1.1",21,"r"],["Exod.20.11",16,"r"],["Jer.32.17",12,"r"],["Heb.1.10",11,"q"],["Heb.1.12",11,"r"],["Gen.2.1",5,"w"],["Heb.3.3",5,"r"],["Heb.3.4",5,"r"],["Prov.8.23",4,"r"],["Prov.8.36",4,"r"]]},{"n":26,"t":"They shall perish, but thou shalt endure: yea, all of them shall wax old like a garment; as a vesture shalt thou change them, and they shall be changed:","x":[["Isa.51.6",20,"e"],["Matt.24.35",16,"r"],["Isa.34.4",7,"r"],["Rev.20.11",5,"r"],["Luke.21.33",4,"r"],["Rom.8.