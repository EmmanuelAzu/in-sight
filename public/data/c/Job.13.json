s? make me to know my transgression and my sin.","it":[[9,12]],"x":[["Ps.139.23",4,"r"],["Job.36.8",4,"r"],["Job.36.9",4,"r"],["Ps.44.20",4,"r"],["Ps.44.21",4,"r"],["Job.22.5",3,"w"]]},{"n":24,"t":"Wherefore hidest thou thy face, and holdest me for thine enemy?","x":[["Job.19.11",6,"r"],["Ps.13.1",5,"w"],["Lam.2.5",5,"w"],["Ps.88.14",4,"w"],["Ps.44.24",4,"w"],["Isa.8.17",4,"w"],["Deut.32.20",4,"w"],["Job.33.10",4,"w"],["Ps.77.6",2,"r"],["Ps.77.9",2,"r"]]},{"n":25,"t":"Wilt thou break a leaf driven to and fro? and wilt thou pursue the dry stubble?","x":[["Job.21.18",3,"w"],["Lev.26.36",3,"w"],["Isa.17.13",2,"r"],["Matt.12.20",2,"w"],["1Sam.24.14",2,"w"],["Job.14.3",2,"r"]]},{"n":26,"t":"For thou writest bitter things against me, and makest me to possess the iniquities of my youth.","x":[["Ps.25.7",6,"w"],["Prov.5.11",2,"r"],["Prov.5.13",2,"r"],["John.5.14",2,"r"],["John.5.5",2,"r"],["Ps.88.3",2,"r"],["Ps.88.18",2,"r"],["Jer.31.19",2,"w"],["Ruth.1.20",2,"r"],["Job.3.20",2,"w"]]},{"n":27,"t":"Thou puttest my feet also in the stocks, and lookest narrowly unto all my paths; thou settest a print upon the heels of my feet.","x":[["Job.33.11",6,"e"],["Job.2.7",2,"r"],["Job.16.9",2,"r"],["2Chr.16.10",2,"r"],["2Chr.16.12",2,"w"],["Acts.16.24",2,"w"],["Job.10.6",2,"r"],["Prov.7.22",2,"w"],["Job.14.16",2,"r"]]},{"n":28,"t":"And he, as a rotten thing, consumeth, as a garment that is moth eaten.","x":[["Job.4.19",3,"w"],["Ps.39.11",3,"w"],["Job.30.17",2,"r"],["Job.30.19",2,"r"],["Hos.5.12",2,"w"],["Num.12.12",2,"r"],["Job.30.29",2,"r"],["Job.30.30",2,"r"]]}]}