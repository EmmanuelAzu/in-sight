{"b":"Ps","c":26,"v":[{"n":1,"t":"Judge me, O LORD; for I have walked in mine integrity: I have trusted also in the LORD; therefore I shall not slide.","it":[[88,97]],"tags":["prayer"],"tm":{"prayer":"Addresses God directly: “O LORD”."},"x":[["Ps.28.7",8,"w"],["Ps.7.8",7,"e"],["Prov.20.7",6,"w"],["Ps.21.7",5,"r"],["2Kgs.20.3",5,"w"],["1Sam.24.15",4,"w"],["Ps.31.14",3,"w"],["1Cor.4.3",3,"w"],["1Cor.4.6",3,"r"],["1Sam.2.9",3,"r"]]},{"n":2,"t":"Examine me, O LORD, and prove me; try my reins and my heart.","tags":["prayer"],"tm":{"prayer":"Addresses God directly: “O LORD”."},"x":[["Ps.139.23",16,"w"],["Ps.139.24",16,"r"],["Ps.7.9",9,"w"],["Ps.17.3",7,"r"],["Job.13.23",4,"r"],["Ps.66.10",3,"r"],["Zech.13.9",3,"w"],["Job.31.4",3,"r"],["Job.31.6",3,"r"],["Jer.20.12",2,"e"]]},{"n":3,"t":"For thy lovingkindness is before mine eyes: and I have walked in thy truth.","it":[[23,25]],"x":[["1John.1.7",6,"r"],["2Kgs.20.3",5,"w"],["2John.1.4",3,"w"],["Eph.4.32",3,"r"],["Eph.5.2",3,"r"],["Matt.5.44",2,"r"],["Matt.5.48",2,"r"],["Ps.52.1",2,"r"],["Ps.101.2",2,"r"],["2Cor.3.18",2,"r"]]},{"n":4,"t":"I have not sat with vain persons, neither will I go in with dissemblers.","x":[["Jer.15.17",8,"w"],["Ps.1.1",8,"r"],["Prov.13.20",6,"r"],["Ps.119.115",6,"r"],["Ps.119.63",5,"r"],["2Cor.6.17",5,"r"],["1Cor.15.33",4,"r"],["Prov.9.6",4,"r"],["Prov.12.11",4,"w"]]},{"n":5,"t":"I have hated the congregation of evildoers; and will not sit with the wicked.","x":[["Ps.31.6",7,"w"],["Ps.101.3",6,"w"],["Ps.101.8",6,"w"],["Ps.139.21",5,"r"],["Ps.139.22",5,"r"],["Ps.1.1",4,"r"],["1Cor.5.9",3,"r"],["1Cor.5.11",3,"r"]]},{"n":6,"t":"I will wash mine hands in innocency: so will I compass thine altar, O LORD:","tags":["prayer"],"tm":{"prayer":"Addresses God directly: “O LORD”."},"x":[["Ps.73.13",6,"w"],["Exod.30.19",4,"w"],["Exod.30.20",4,"e"],["Isa.1.16",4,"w"],["Isa.1.18",4,"r"],["Matt.5.23",3,"w"],["Matt.5.24",3,"w"],["Ps.43.4",3,"w"],["Heb.10.19",3,"r"],["Heb.10.22",3,"r"]]},{"n":7,"t":"That I may publish with the voice of thanksgiving, and tell of all thy wondrous works.","x":[["Ps.9.1",6,"w"],["Ps.71.17",5,"w"],["Ps.71.19",5,"r"],["Ps.145.5",4,"w"],["Ps.100.4",3,"w"],["Ps.100.5",3,"r"],["1Sam.1.24",3,"r"],["Luke.19.37",3,"w"],["Luke.19.40",3,"w"],["Ps.72.18",3,"w"]]},{"n":8,"t":"LORD, I have loved the habitation of thy house, and the place where thine honour dwelleth.","x":[["John.2.14",6,"r"],["John.2.17",6,"r"],["Ps.27.4",5,"r"],["Ps.27.6",5,"r"],["Ps.122.9",4,"r"],["Ps.84.1",4,"r"],["Ps.84.2",4,"r"],["Ps.84.10",4,"r"],["Exod.25.21",3,"r"],["Exod.25.22",3,"r"]]},{"n":9,"t":"Gather not my soul with sinners, nor my life with bloody men:","x":[["Ps.139.19",3,"w"],["Rev.22.14",3,"r"],["Rev.22.15",3,"r"],["Matt.25.44",2,"r"],["Ps.55.23",2,"w"],["Mal.3.18",2,"r"],["Matt.24.51",2,"r"],["1Sam.25.29",2,"r"],["1Sam.22.18",2,"r"],["1Sam.22.19",2,"r"]]},{"n":10,"t":"In whose hands is mischief, and their right hand is full of bribes.","it":[[15,17]],"x":[["Deut.16.19",4,"r"],["1Sam.8.3",3,"w"],["Exod.23.8",3,"r"],["Ps.52.2",3,"r"],["Ps.10.14",2,"w"],["Matt.26.3",2,"r"],["Matt.26.4",2,"r"],["Acts.23.12",2,"r"],["Ps.11.2",2,"r"],["Amos.5.12",2,"w"]]},{"n":11,"t":"But as for me, I will walk in mine integrity: redeem me, and be merciful unto me.","x":[["Ps.26.1",4,"w"],["Ps.69.18",4,"w"],["1Pet.1.18",3,"r"],["1Pet.1.19",3,"r"],["1Thess.2.10",3,"r"],["Neh.13.31",2,"r"],["2Chr.31.20",2,"r"],["2Chr.31.21",2,"r"],["Ps.103.3",2,"r"],["Ps.103.4",2,"r"]]},{"n":12,"t":"My foot standeth in an even place: in the congregations will I bless the LORD.","x":[["Ps.27.11",7,"r"],["Ps.40.2",5,"r"],["Ps.111.1",5,"r"],["1Sam.2.9",3,"r"],["Ps.22.22",3,"r"],["Ps.22.25",3,"r"],["Prov.10.9",3,"r"],["Ps.26.7",2,"r"],["Ps.122.4",2,"r"],["Heb.2.12",2,"r"]]}],"title":"A Psalm of David."}