1",3,"r"],["Judg.4.2",3,"r"],["Judg.3.8",3,"r"],["Deut.28.25",2,"r"],["Deut.28.33",2,"r"],["Judg.10.7",2,"r"]]},{"n":42,"t":"Their enemies also oppressed them, and they were brought into subjection under their hand.","x":[["Judg.10.12",2,"r"],["Judg.4.3",2,"w"]]},{"n":43,"t":"Many times did he deliver them; but they provoked him with their counsel, and were brought low for their iniquity.","it":[[50,53]],"x":[["Judg.2.16",6,"r"],["Judg.2.18",6,"r"],["Ps.81.12",6,"r"],["Ps.1.1",4,"w"],["1Sam.12.9",3,"r"],["1Sam.12.11",3,"r"],["Ps.106.29",2,"w"],["1Sam.13.19",2,"r"],["Judg.5.8",2,"r"],["Judg.6.5",2,"r"]]},{"n":44,"t":"Nevertheless he regarded their affliction, when he heard their cry:","x":[["Judg.3.9",7,"r"],["Judg.4.3",5,"r"],["1Sam.7.8",3,"w"],["1Sam.7.12",3,"r"],["Judg.6.6",3,"r"],["Judg.6.10",3,"r"],["Judg.2.18",3,"r"],["Judg.10.10",3,"r"],["Judg.10.16",3,"r"],["2Kgs.14.26",3,"w"]]},{"n":45,"t":"And he remembered for them his covenant, and repented according to the multitude of his mercies.","x":[["Ps.105.8",6,"w"],["Judg.2.18",5,"w"],["Ps.51.1",4,"e"],["Exod.32.14",4,"w"],["Lam.3.32",4,"e"],["Ps.69.16",4,"e"],["Lev.26.40",4,"r"],["Lev.26.42",4,"w"],["2Kgs.13.23",4,"w"],["Ps.90.13",3,"r"]]},{"n":46,"t":"He made them also to be pitied of all those that carried them captives.","x":[["Jer.42.12",5,"r"],["Ezra.9.9",5,"r"],["1Kgs.8.50",4,"w"],["Jer.15.11",4,"r"],["Neh.1.11",3,"r"],["2Chr.30.9",2,"r"]]},{"n":47,"t":"Save us, O LORD our God, and gather us from among the heathen, to give thanks unto thy holy name, and to triumph in thy praise.","it":[[98,101]],"tags":["prayer"],"tm":{"prayer":"Addresses God directly: “O LORD”."},"x":[["1Chr.16.35",4,"q"],["1Chr.16.36",4,"r"],["Ezek.36.24",3,"w"],["Ezek.36.28",3,"r"],["Rev.7.10",3,"r"],["Rev.7.12",3,"r"],["Ps.107.1",2,"w"],["Ps.107.3",2,"r"],["Ezek.39.25",2,"e"],["Ezek.39.29",2,"r"]]},{"n":48,"t":"Blessed be the Lord God of Israel from everlasting to everlasting: and let all the people say, Amen. Praise ye the LORD.","it"